# Optional Kroger Public API (Products only — locationIds are hardcoded in src/lib/area-stores.ts)
# certification → https://api-ce.kroger.com/v1  |  production → https://api.kroger.com/v1
#
# Use matching credentials for the host:
#   KROGER_ENV=certification  → Certification app (client id/secret from Cert Products)
#   KROGER_ENV=production     → Production Public app (separate credentials; Cert keys get 401 on prod)
#
# Diagnose with: npm run kroger:probe
KROGER_ENV=certification
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Optional: pin which Kroger location is searched first for live products.
# Full FM + QFC roster lives in src/lib/area-stores.ts.
KROGER_LOCATION_ID=70100053
KROGER_ZIP=98042

# Durable price cache (SQLite) — default path for optimize/suggest before live Kroger.
# Fresh observations under max age are merged as "live"; seed shelf is dropped for those stores.
# PRICE_CACHE_PATH=data/prices.sqlite
# PRICE_CACHE_MAX_AGE_HOURS=24
# PRICE_CACHE_ONLY=1

# App DB for lists, users, sessions, receipts (separate from price cache)
# APP_DB_PATH=data/app.sqlite

# Auth (MVP): scrypt N=16384,r=8,p=1,keylen=32 — see src/lib/user-store.ts.
# In-memory rate limits (10/min per IP): /api/auth/login, /api/auth/register, DELETE /api/account.

# --- Production launch checklist (ops; no secrets here) ---
# [ ] KROGER_ENV=production with Production Public app credentials (Cert keys 401 on prod)
# [ ] Daily warm: npm run prices:refresh on the host that owns data/prices.sqlite
#     (GitHub Action .github/workflows/prices-refresh.yml needs the same secrets;
#      it uploads an artifact — it does not replace a self-hosted DB automatically)
# [ ] Verify: npm run prices:stats  and  npm run prices:refresh:check
# [ ] PRICE_CACHE_MAX_AGE_HOURS matches your refresh cadence (default 24)
# [ ] Diagnose live edge: npm run kroger:probe

# --- Capacitor Android (WebView → Next host) ---
# Emulator default is http://10.0.2.2:3000 when unset (see capacitor.config.ts).
# Physical device: http://<LAN-IP>:3000
# Production: https://your-hosted-grocer.example
# After changing: npm run cap:sync
# Full production host checklist: docs/DEPLOY.md
# CAPACITOR_SERVER_URL=http://10.0.2.2:3000
